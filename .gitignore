# ─── 敏感文件（绝不提交）──────────────────────────
.env
.env.*
!.env.example

# ─── 用户本地配置（含真实 key 时不提交）──────────
agent/config/config.yaml
agent/config/config.*.yaml
!agent/config/config.example.yaml

# ─── 运行时状态与产物 ─────────────────────────────
agent/state/
agent/state.weixin/
agent/workspace/

# ─── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─── 测试与覆盖率 ─────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ─── IDE / 编辑器 ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── 日志 ────────────────────────────────────────
*.log
logs/
