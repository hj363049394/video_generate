# 小红书仿写 Agent · 环境变量模板
#
# 用法：
#   1. cp .env.example .env
#   2. 编辑 .env 填入真实 key（.env 已被 .gitignore 忽略，不会提交）
#   3. main.py 启动时会自动加载 .env 文件
#
# 获取地址：
#   ARK_API_KEY       → https://console.volcengine.com/ark （火山方舟，生图+TTS）
#   REDFOX_API_KEY    → https://redfox.hk                  （红狐，笔记抓取+视频提文案）
#   LLM_API_KEY       → https://bailian.console.aliyun.com （阿里百炼，kimi-k3 等仿写 LLM）

# 火山方舟 Agent Plan（生图 doubao-seedream-5.0-lite + TTS seed-tts-2.0）
ARK_API_KEY=

# 红狐 RedFoxHub（雷达搜索 + 笔记详情抓取 + 视频提文案）
REDFOX_API_KEY=

# 阿里百炼 LLM（OpenAI 兼容端点，kimi-k3/glm-5.3/qwen3.8-max/deepseek-v4-pro）
LLM_API_KEY=

# ─── 以下非必需，默认走 config.yaml ───────────────────

# 雷达推送接收人 wx_id（每日 8:00 自动推送选题清单）
HOME_UID=
